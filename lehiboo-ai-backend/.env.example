# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modèle IA par défaut
# Options: anthropic/claude-3.5-sonnet, openai/gpt-4-turbo, meta-llama/llama-3.1-70b-instruct
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# WordPress Integration
WORDPRESS_URL=https://lehiboo.dilios.me
WORDPRESS_API_URL=https://lehiboo.dilios.me/wp-json
WORDPRESS_API_KEY=your-wordpress-api-key

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-for-wordpress-plugin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Weather API
# Option 1 (Recommandé) : Open-Meteo - 100% GRATUIT, SANS CLÉ API, ILLIMITÉ
#   Activé par défaut si WEATHER_API_KEY non défini
#   Documentation: https://open-meteo.com
#   Fichier: src/services/weather-service-openmeteo.js
#
# Option 2 : OpenWeatherMap - Gratuit limité (1000 appels/jour)
#   Nécessite inscription: https://openweathermap.org/api
#   Décommentez et ajoutez votre clé:
# WEATHER_API_KEY=your-openweathermap-api-key
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# MCP Configuration
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:3001

# Redis Cache (optionnel)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_DSN=
