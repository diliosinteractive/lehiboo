# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modèle IA par défaut
# Options:
#   - deepseek/deepseek-chat-v3.1:free (GRATUIT, recommandé pour développement)
#   - anthropic/claude-3.5-sonnet (payant, meilleure qualité)
#   - openai/gpt-4-turbo (payant)
#   - meta-llama/llama-3.1-70b-instruct (gratuit)
DEFAULT_MODEL=deepseek/deepseek-chat-v3.1:free

# WordPress Integration
WORDPRESS_URL=https://lehiboo.dilios.me
WORDPRESS_API_URL=https://lehiboo.dilios.me/wp-json
WORDPRESS_API_KEY=your-wordpress-api-key

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-for-wordpress-plugin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# MCP Configuration
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:3001

# Redis Cache (optionnel)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_DSN=
