# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# OpenAI Configuration
# Obtenir une clé API sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Modèle IA par défaut
# Options:
#   - gpt-4o-mini (recommandé, ~16x moins cher que gpt-4o)
#   - gpt-4o (plus puissant mais plus cher)
#   - gpt-4-turbo (encore plus cher)
DEFAULT_MODEL=gpt-4o-mini

# WordPress Integration
WORDPRESS_URL=https://lehiboo.dilios.me
WORDPRESS_API_URL=https://lehiboo.dilios.me/wp-json
WORDPRESS_API_KEY=your-wordpress-api-key

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-for-wordpress-plugin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# MCP Configuration
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:3001

# Redis Cache (optionnel)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_DSN=
