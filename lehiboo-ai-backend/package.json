{
  "name": "lehiboo-ai-backend",
  "version": "1.0.0",
  "description": "Backend Node.js pour Le Hiboo AI Assistant avec AI SDK et OpenAI",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon src/index.js",
    "start": "NODE_ENV=production node src/index.js",
    "test": "NODE_ENV=test node --test",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "ai",
    "chat",
    "openai",
    "mcp",
    "ai-sdk"
  ],
  "author": "Le Hiboo",
  "license": "MIT",
  "dependencies": {
    "ai": "^3.3.0",
    "@ai-sdk/openai": "^0.0.48",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.5",
    "zod": "^3.22.4",
    "node-fetch": "^3.3.2",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
