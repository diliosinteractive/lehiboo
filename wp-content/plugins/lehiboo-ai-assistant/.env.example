# Le Hiboo AI Assistant - Configuration Backend
# Copier ce fichier en .env et remplir les valeurs

# ============================================
# API KEYS (OBLIGATOIRES)
# ============================================

# OpenRouter API Key (pour l'IA multi-modèles)
# Obtenir sur: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenWeatherMap API Key (pour météo)
# Obtenir sur: https://openweathermap.org/api
# Tier gratuit: 1000 appels/jour (suffisant pour démarrer)
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# CONFIGURATION SERVEUR
# ============================================

# Port du serveur Node.js
PORT=3000

# Environnement (development, staging, production)
NODE_ENV=development

# Origins autorisées (CORS)
# Séparer par virgules si plusieurs
ALLOWED_ORIGINS=http://localhost,http://localhost:8000,https://lehiboo.com

# ============================================
# WORDPRESS INTEGRATION
# ============================================

# URL de base de l'API WordPress
WORDPRESS_API_URL=https://votre-site.com/wp-json

# Token d'authentification WordPress
# Générer dans: WordPress Admin > Utilisateurs > Mots de passe d'application
WORDPRESS_API_TOKEN=xxxx xxxx xxxx xxxx xxxx xxxx

# ============================================
# CONFIGURATION IA
# ============================================

# Modèle IA par défaut
# Options populaires:
# - anthropic/claude-3.5-sonnet (recommandé, ~0.015€/conv)
# - openai/gpt-4-turbo (~0.01€/conv)
# - google/gemini-pro (gratuit, limité)
# - mistralai/mistral-large (~0.008€/conv)
DEFAULT_AI_MODEL=anthropic/claude-3.5-sonnet

# Tokens maximum par réponse
MAX_TOKENS=4000

# Température (0-1, plus élevé = plus créatif)
TEMPERATURE=0.7

# Modèle alternatif si le principal échoue
FALLBACK_AI_MODEL=openai/gpt-4-turbo

# ============================================
# RATE LIMITING
# ============================================

# Fenêtre de temps en millisecondes (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Nombre max de requêtes par fenêtre
RATE_LIMIT_MAX_REQUESTS=20

# Bloquer IP abusives automatiquement
AUTO_BLOCK_ABUSIVE_IPS=true

# Durée de blocage en secondes (3600 = 1 heure)
IP_BLOCK_DURATION=3600

# ============================================
# SÉCURITÉ
# ============================================

# Secret JWT pour authentication (générer aléatoirement)
JWT_SECRET=changez_moi_par_une_vraie_clef_secrete_aleatoire_256bits

# Activer HTTPS uniquement en production
FORCE_HTTPS=false

# Longueur max message utilisateur (caractères)
MAX_MESSAGE_LENGTH=2000

# Timeout requêtes API en millisecondes
API_TIMEOUT_MS=30000

# ============================================
# LOGGING & MONITORING
# ============================================

# Niveau de log (error, warn, info, debug)
LOG_LEVEL=info

# Sentry DSN (optionnel, pour monitoring erreurs)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Activer logs détaillés (debug)
DEBUG_MODE=false

# ============================================
# CACHE (OPTIONNEL)
# ============================================

# Activer cache Redis (si disponible)
ENABLE_REDIS_CACHE=false

# URL Redis
# REDIS_URL=redis://localhost:6379

# TTL cache en secondes (3600 = 1 heure)
CACHE_TTL=3600

# ============================================
# ANALYTICS (OPTIONNEL)
# ============================================

# Google Analytics ID
# GA_TRACKING_ID=G-XXXXXXXXXX

# Posthog API Key (analytics open-source)
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# BASE DE DONNÉES (OPTIONNEL)
# ============================================

# Si vous voulez stocker conversations dans DB dédiée
# Sinon, WordPress DB est utilisé

# DATABASE_URL=postgresql://user:password@localhost:5432/lehiboo_ai

# ============================================
# FEATURES FLAGS
# ============================================

# Activer mode vocal (Speech-to-Text)
ENABLE_VOICE_MODE=false

# Activer packages weekend automatiques
ENABLE_WEEKEND_PLANNER=true

# Activer intégration météo
ENABLE_WEATHER_INTEGRATION=true

# Activer mode multilangue
ENABLE_MULTILANGUAGE=false

# ============================================
# LIMITES & QUOTAS
# ============================================

# Budget max IA par jour (en euros)
MAX_AI_COST_PER_DAY=50

# Alerter si dépassement % du budget
ALERT_BUDGET_THRESHOLD_PERCENT=80

# Email pour alertes (optionnel)
# ALERT_EMAIL=admin@lehiboo.com

# ============================================
# INTÉGRATIONS TIERCES (OPTIONNEL)
# ============================================

# Stripe (pour paiements directs)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio (pour SMS notifications)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid (pour emails)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# NOTES
# ============================================

# Ce fichier .env ne doit JAMAIS être commité sur Git !
# Ajouter .env dans .gitignore

# Pour production:
# 1. Copier ce fichier sur le serveur
# 2. Remplir toutes les valeurs OBLIGATOIRES
# 3. Chmod 600 .env (lecture seule par owner)
# 4. Redémarrer le serveur Node.js

# Pour tester localement:
# 1. Copier en .env
# 2. Remplir au minimum:
#    - OPENROUTER_API_KEY
#    - WORDPRESS_API_URL
#    - WORDPRESS_API_TOKEN
# 3. npm run dev

# Questions ? Voir README.md ou IMPLEMENTATION_GUIDE.md
